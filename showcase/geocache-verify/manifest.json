        "type": "integer"
      },
      "complete": {
        "type": "boolean"
      },
      "reveal_match": {
        "type": "string",
        "enum": [
          "not_checked",
          "match",
          "mismatch"
        ]
      },
      "gate_status": {
        "type": "string",
        "enum": [
          "locked",
          "unlocked"
        ]
      },
      "revealed_key": {
        "type": "integer"
      }
    }
  },
  "execution": {
    "type": "browser-javascript",
    "entry": "index.html",
    "function_name": "calculate",
    "timeout_ms": 3000
  },
  "mcp_tool_definition": {
    "name": "geocache_verify",
    "description": "Given a cache identifier, a required fragment count, a list of collected fragments, and an optional expected reveal key, checks completeness and folds the sorted fragment set into a reveal key. Deterministic, zero external data.",
