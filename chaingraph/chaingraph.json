  "$schema": "https://apexlogics.org/schema/chaingraph-v1.0.json",
  "version": "1.0.0-scaffold",
  "updated": "2026-06-13",
  "maintainer": "Apex Advisors",
  "status": "SCAFFOLD — metadata + journeys complete; nodes[] to be script-generated from tool manifests (see generation_contract).",
  "description": "Machine-readable index of the ApexLogics decision chain-graph: tool nodes + persona journeys. Each tool emits a typed AP2 artifact with a verifiable execution_hash and chain block; journeys are persona-grouped sequences of tools with verified artifact pass-through. Linked from llms.txt and embedded as JSON-LD on the hub. Primary agent-discovery surface.",
  "hub_url": "https://apexlogics.org/index.html",
  "mcp_server": "https://apexlogics.org/.well-known/mcp.json",
  "license": "CC BY 4.0",
  "suite_claim": "Client-side, zero-PII life-decision tools whose exports are typed, chainable, and traceable to a reproducible execution hash — verifiable end-to-end, agent-composable, and hand-off-ready to an LLM or human advisor.",

  "five_tests": [
    "Emits a typed AP2 decision artifact (ap2_version 2.1.0, mandate_type, tool_id, execution_hash, chain block, payload, audit_signature)",
    "Exposes an MCP tools/call endpoint with typed inputSchema, deterministic output parseable without vision",
    "Exports a decision, not reference data — an ROI, break-even, eligibility verdict, or determination",
    "Is chainable — its mandate_type is a valid inbound type for >=1 other tool (seed edges from CONTRACT §6.3 handoff map)",
    "Carries a verifiable anchor — execution_hash recomputable client-side via WebCrypto SHA-256 (CONTRACT §4.4 / CG-28)"
  ],

  "model": {
    "rule": "1 chaingraph = 1 persona. A chaingraph bundles that persona's journeys behind an up-front selector (user picks scenario -> only their journey renders). Personas never mix.",
    "conversion": "in place — each former workflow keeps its URL; upgraded to verified artifact pass-through.",
    "embed": "minimal compute per step + shared constants module (apex-constants-2026.js). Do not replicate full tools into chaingraphs.",
    "ap2_version": "2.1.0",
    "locked": "2026-06-13"
  },

  "chain_block_spec": {
    "parent_hashes": "sha256:<execution_hash> of each upstream artifact consumed this run",
    "parent_tool_ids": "tool_id of each parent",
    "chain_depth": "0 for root; max(parent depths)+1 for chained artifacts",
    "hash": "sha256 over sorted-key, whitespace-stripped JSON of {policy_parameters, output_payload} via WebCrypto crypto.subtle.digest — identical canonicalization to AINumbers ChainGraph, so hashes are cross-suite verifiable",
    "verification": "re-run the parent tool with the same inputs, recompute the hash, confirm the cited value"
  },

  "constants_ssot_ref": "apex-constants-2026.js (CONTRACT §3.5)",
  "advisor_prompt_composer": "ap2-advisor-prompt-composer (PTG analogue; template registry repo/data/advisor-templates.json)",
  "mandate_type_registry_ref": "data/advisor-templates.json",

  "personas": [
    "worker", "grad-applicant", "freelancer", "immigrant-visa-holder", "student",
    "federal-employee", "educator", "new-parent-caregiver", "employer", "parent",
    "veteran", "trades", "nurse-healthcare"
  ],

