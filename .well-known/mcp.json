{
  "$schema": "https://mcp.run/schema/mcp-discovery-v1.json",
  "spec": "SEP-1649",
  "spec_version": "1.0",
  "publisher": "Apex Advisors",
  "publisher_url": "https://apexadvisory.site",
  "suite": {
    "name": "ApexLogics — EdTech & CareerTech Intelligence Suite",
    "url": "https://apexlogics.org",
    "description": "35 deterministic, privacy-first career and education tools for students, career changers, working professionals, parents, counselors, and workforce boards. All tools run in-browser with zero PII collection. AP2-compliant for agent cross-tool scenario handoff.",
    "license": "CC-BY-4.0",
    "sister_suite": {
      "name": "AINumbers.co",
      "url": "https://ainumbers.co",
      "domain": "fintech",
      "publisher": "Post Oak Labs"
    }
  },
  "registry": {
    "url": "https://apexlogics.org/suite-registry.json",
    "schema": "https://apexlogics.org/schema/mcp-registry-v1.1.json",
    "version": "4.0.0",
    "tools_count": 35,
    "tools_count_total_active": 35
  },
  "agent_index": {
    "url": "https://apexlogics.org/llms.txt",
    "format": "llms.txt"
  },
  "ap2": {
    "protocol": "google_agent_purchase_protocol_sep_2025",
    "version": "1.0",
    "mandate_types": [
      "credential_roi_evaluation",
      "human_capital_assessment",
      "automation_exposure_score",
      "career_resilience_score",
      "workforce_program_roi",
      "career_pivot_assessment",
      "career_transition_record",
      "scholarship_pipeline_plan",
      "fafsa_sai_estimate",
      "exam_pathway_plan",
      "benefits_election_record",
      "severance_decision_record",
      "offer_negotiation_record",
      "graduate_school_roi_record",
      "apprenticeship_match_record",
      "cpd_credit_record",
      "job_search_roi_record",
      "career_break_record",
      "total_comp_record",
      "geo_arbitrage_record",
      "education_savings_record",
      "visa_strategy_record",
      "license_reciprocity_record",
      "loan_repayment_record",
      "freelance_total_cost_record",
      "mba_roi_evaluation",
      "test_prep_roi_record",
      "international_student_cost_record",
      "parent_college_roi_record",
      "equity_compensation_record",
      "ai_skills_premium_record",
      "federal_comp_record",
      "education_path_record",
      "remote_tax_record",
      "noncompete_risk_record",
      "professional_degree_record",
      "military_civilian_record"
    ],
    "handoff_protocol": {
      "method": "url_param",
      "param": "ap2",
      "encoding": "encodeURIComponent(JSON.stringify(mandate))",
      "decoding": "JSON.parse(decodeURIComponent(param))",
      "fallback": "paste_modal"
    }
  },
  "execution": {
    "type": "browser-javascript",
    "runtime": "synchronous-deterministic",
    "zero_network": true,
    "zero_pii": true,
    "storage": "sessionStorage apex_lang only"
  },
  "discovery": {
    "per_tool_manifest": "https://apexlogics.org/tools/{tool-slug}/manifest.json",
    "per_tool_url_pattern": "https://apexlogics.org/tools/{tool-slug}/",
    "inbound_handoff_url_pattern": "https://apexlogics.org/tools/{tool-slug}/?ap2={encoded_mandate}"
  },
  "categories": [
    "education_path_roi",
    "compensation_offers",
    "career_transition_mobility",
    "licensing_credentials",
    "student_finance_debt",
    "workforce_development",
