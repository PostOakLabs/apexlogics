{
  "tool_id": "noncompete-risk-screener",
  "al_id": "AL-38",
  "version": "1.0.0",
  "title": "Non-Compete Risk & Enforceability Screener",
  "description": "Scores a non-compete agreement on a 0–100 enforceability risk scale based on state law tier (void/restrictive/moderate/broad), duration, geographic scope, role, consideration, and garden leave. All 50 states + DC classified. Outputs plain-language flags, recommendations, and disclaimer. General legal information only — not legal advice.",
  "category": "career_transition_mobility",
  "journeys": ["career_transition"],
  "personas": ["working_professional", "career_changer"],
  "tags": ["non-compete", "legal", "employment", "enforceability", "job-change"],
  "status": "shipped",
  "shipped_date": "2026-05-28",
  "maintenance": "medium",
  "data_vintage": "State non-compete statute and case law landscape as of 2025",
  "frozen_baseline": false,
  "input_schema": {
    "type": "object",
    "properties": {
      "state_signed": { "type": "string" },
      "state_works": { "type": "string" },
      "duration": { "type": "string", "enum": ["lte6", "m6to12", "m12to24", "gt24"] },
      "geo_scope": { "type": "string", "enum": ["city", "single_state", "multi_state", "national"] },
      "salary": { "type": "number" },
      "role": { "type": "string", "enum": ["executive", "technical", "sales", "professional", "low_wage"] },
      "consideration": { "type": "string", "enum": ["new_hire", "promotion", "mid_employment", "none"] },
      "garden_leave": { "type": "boolean" }
    },
    "required": ["state_signed", "state_works", "duration", "geo_scope", "role", "consideration"]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "risk_score": { "type": "integer", "minimum": 0, "maximum": 100 },
      "risk_label": { "type": "string" },
      "state_tier": { "type": "string" },
      "flags": { "type": "array", "items": { "type": "string" } },
      "recommendation": { "type": "string" }
    }
  },
  "mcp_tool_definition": {
    "name": "screen_noncompete_risk",
    "description": "Given state(s), agreement terms, role, and consideration, returns a 0–100 enforceability risk score with label, state law summary, and recommendation. Uses embedded state enforceability classification. Deterministic. Output is general information only, not legal advice.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "state_signed": { "type": "string" },
        "state_works": { "type": "string" },
        "duration": { "type": "string" },
        "geo_scope": { "type": "string" },
        "role": { "type": "string" }
      },
      "required": ["state_signed", "duration", "geo_scope", "role"]
    }
  },
  "execution": {
    "type": "browser-javascript",
    "entry": "index.html",
    "function_name": "scoreNonCompete",
    "timeout_ms": 3000
  },
  "ap2_export": true,
  "ap2_mandate_types": ["noncompete_risk_record"],
  "downstream_handoff_candidates": ["AL-25"],
  "sister_suite": "https://ainumbers.co",
  "consulting_site": "https://apexadvisory.site",
  "license": "CC-BY-4.0",
  "regulatory_citations": [
    "FTC Non-Compete Clause Rule (2024) — stayed by federal court pending appeal",
    "CA Business & Professions Code §16600",
    "MN Stat. §181.988 (2023)",
    "MA Non-Competition Agreement Act (2018)",
    "IL Freedom to Work Act (2022 amendments)",
    "FL Stat. §542.335",
    "GA Code §13-8-50 et seq. (Restrictive Covenants Act)"
  ]
}
