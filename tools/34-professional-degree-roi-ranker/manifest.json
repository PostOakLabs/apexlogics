{
  "tool_id": "34-professional-degree-roi-ranker",
  "al_id": "AL-39",
  "version": "1.0.0",
  "title": "Professional Degree ROI Ranker",
  "description": "Compares up to 3 professional degree paths (MD/DO/JD/PharmD/DVM/MBA/BA) across specialties with embedded median salaries, training years, and cost ranges. Calculates break-even age, NPV over career horizon, and DTI ratio. Flags late-entry risk (break-even >50) and over-leverage (DTI >2.0). Side-by-side 13-row comparison table with winner indicator.",
  "category": "education_path_roi",
  "journeys": ["education_planning"],
  "personas": ["student", "career_changer"],
  "tags": ["professional-degree", "md", "jd", "mba", "roi", "break-even", "npv"],
  "status": "shipped",
  "shipped_date": "2026-05-28",
  "maintenance": "low",
  "data_vintage": "AAMC 2024 Physician Specialty Salary Data, BLS OEWS 2024, NCES IPEDS 2023-24",
  "frozen_baseline": false,
  "input_schema": {
    "type": "object",
    "properties": {
      "paths": {
        "type": "array",
        "minItems": 1,
        "maxItems": 3,
        "items": {
          "type": "object",
          "properties": {
            "degree_type": { "type": "string", "enum": ["MD", "DO", "JD", "PharmD", "DVM", "MBA", "BA"] },
            "specialty": { "type": "string" },
            "school_cost_annual": { "type": "number" },
            "scholarship_annual": { "type": "number" }
          },
          "required": ["degree_type"]
        }
      },
      "current_age": { "type": "integer", "minimum": 18, "maximum": 60 }
    },
    "required": ["paths", "current_age"]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "comparison": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "degree": { "type": "string" },
            "specialty": { "type": "string" },
            "net_cost": { "type": "number" },
            "break_even_age": { "type": "number" },
            "npv_career": { "type": "number" },
            "dti": { "type": "number" },
            "warnings": { "type": "array", "items": { "type": "string" } }
          }
        }
      },
      "winner": { "type": "string" }
    }
  },
  "mcp_tool_definition": {
    "name": "rank_professional_degree_roi",
    "description": "Given 1–3 professional degree paths with specialty, school cost, and current age, returns break-even age, career NPV, DTI ratio, and winner. Uses embedded salary and training-year data. Deterministic.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "paths": { "type": "array" },
        "current_age": { "type": "integer" }
      },
      "required": ["paths", "current_age"]
    }
  },
  "execution": {
    "type": "browser-javascript",
    "entry": "index.html",
    "function_name": "rankDegreeROI",
    "timeout_ms": 3000
  },
  "ap2_export": true,
  "ap2_mandate_types": ["professional_degree_record"],
  "downstream_handoff_candidates": ["AL-26", "AL-13"],
  "sister_suite": "https://ainumbers.co",
  "consulting_site": "https://apexadvisory.site",
  "license": "CC-BY-4.0",
  "regulatory_citations": [
    "AAMC 2024 Physician Specialty Salary Survey",
    "NALP 2024 Associate Salary Survey",
    "BLS Occupational Employment and Wage Statistics 2024",
    "NCES IPEDS Tuition and Fees 2023-24"
  ]
}
