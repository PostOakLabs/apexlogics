{
  "tool_id": "03-graduate-school-roi-comparator",
  "al_id": "AL-26",
  "version": "1.0.0",
  "title": "Graduate School ROI Comparator",
  "description": "Compare up to 3 graduate programs side-by-side on NPV, IRR, break-even, and total investment. Uses NCES IPEDS 2023-24 tuition data and BLS OEWS May 2023 wage benchmarks. Accepts Policy Mandate inbound mandates from AL-02 (Credential ROI Suite) and AL-17 (FAFSA SAI Simulator).",
  "category": "education_path_roi",
  "journeys": ["education_path"],
  "personas": ["student", "career_changer", "working_professional", "counselor"],
  "tags": ["graduate school", "roi", "npv", "irr", "mba", "tuition", "salary premium", "break-even", "nces", "bls", "career investment"],
  "status": "shipped",
  "maintenance": "low",
  "data_vintage": "NCES IPEDS 2023-24 · BLS OEWS May 2023 · MBA Employment Reports 2023",
  "frozen_baseline": true,
  "input_schema": {
    "type": "object",
    "required": ["programs", "current_salary"],
    "properties": {
      "programs": {
        "type": "array",
        "maxItems": 3,
        "items": {
          "type": "object",
          "properties": {
            "institution_id": { "type": "string", "description": "Program ID from embedded NCES list, or 'custom'" },
            "label": { "type": "string" },
            "annual_tuition": { "type": "number", "minimum": 0 },
            "fellowship_annual": { "type": "number", "minimum": 0 },
            "living_delta_annual": { "type": "number" },
            "program_years": { "type": "number", "minimum": 0.5 },
            "post_degree_salary": { "type": "number", "minimum": 0 },
            "field_key": { "type": "string", "description": "BLS field key for salary lookup" }
          }
        }
      },
      "current_salary": { "type": "number", "minimum": 0 },
      "career_horizon_years": { "type": "number", "minimum": 5, "maximum": 45, "default": 25 },
      "discount_rate_pct": { "type": "number", "minimum": 0, "maximum": 20, "default": 5 },
      "salary_growth_pct": { "type": "number", "minimum": 0, "maximum": 10, "default": 2 }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "programs": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "label": { "type": "string" },
            "net_annual_tuition": { "type": "number" },
            "total_investment": { "type": "number" },
            "opportunity_cost": { "type": "number" },
            "annual_premium": { "type": "number" },
            "break_even_year": { "type": ["number", "null"] },
            "npv": { "type": "number" },
            "irr": { "type": ["number", "null"] },
            "ten_year_gain": { "type": "number" }
          }
        }
      },
      "winner_label": { "type": "string" },
      "assumptions": {
        "type": "object",
        "properties": {
          "current_salary": { "type": "number" },
          "career_horizon_years": { "type": "number" },
          "discount_rate": { "type": "number" },
          "annual_salary_growth": { "type": "number" }
        }
      }
    }
  },
  "mcp_tool_definition": {
    "name": "compare_graduate_school_roi",
    "description": "Compare up to 3 graduate programs on NPV, IRR, break-even, and total investment. Returns full ROI analysis using NCES IPEDS 2023-24 tuition data and BLS OEWS May 2023 wage benchmarks. Accepts Policy Mandate inbound mandates from AL-02 and AL-17.",
    "inputSchema": {
      "type": "object",
      "required": ["programs", "current_salary"],
      "properties": {
        "programs": { "type": "array", "maxItems": 3, "description": "Array of up to 3 graduate programs to compare" },
        "current_salary": { "type": "number", "description": "Pre-degree annual salary in USD" },
        "career_horizon_years": { "type": "number", "default": 25, "description": "Total years from today for NPV/IRR calculation" },
        "discount_rate_pct": { "type": "number", "default": 5, "description": "Discount rate as a percentage (e.g. 5 = 5%)" },
        "salary_growth_pct": { "type": "number", "default": 2, "description": "Annual salary growth rate as a percentage" }
      }
    }
  },
  "execution": {
    "type": "browser-javascript",
    "entry": "index.html",
    "function_name": "runComparison",
    "timeout_ms": 5000
  },
  "ap2_export": true,
  "ap2_mandate_types": ["graduate_school_roi_record"],
  "ap2_inbound_mandate_types": ["credential_roi_evaluation", "fafsa_sai_estimate"],
  "regulatory_citations": [
    "NCES IPEDS 2023-24 Institutional Characteristics Survey — graduate and professional tuition data",
    "Bureau of Labor Statistics Occupational Employment and Wage Statistics (OEWS) May 2023",
    "School-published MBA Employment Reports, Class of 2023 (MBACSEA reporting standards)"
  ],
  "sister_suite": "https://ainumbers.co",
  "consulting_site": "https://postoaklabs.com",
  "license": "CC-BY-4.0"
}
