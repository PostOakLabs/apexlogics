  "mcp_tool_definition": {
    "name": "pslf_qualifying_payment_counter",
    "description": "Calculate PSLF progress, monthly payment under IDR plans, projected forgiveness amount and timeline. Uses 2026 FPL and OBBBA RAP formula.",
    "inputSchema": {
      "type": "object",
      "required": ["loan_balance", "agi", "family_size", "qualifying_payments_made"],
      "properties": {
        "loan_balance": {"type": "number"},
        "agi": {"type": "number"},
        "family_size": {"type": "integer", "default": 1},
        "qualifying_payments_made": {"type": "integer"},
        "repayment_plan": {"type": "string", "enum": ["RAP","IBR","PAYE","REPAYE"], "default": "RAP"},
        "is_direct_loan": {"type": "boolean", "default": true},
        "employer_type": {"type": "string", "enum": ["nonprofit","federal","state","local","other_public"], "default": "nonprofit"}
      }
    }
  }
