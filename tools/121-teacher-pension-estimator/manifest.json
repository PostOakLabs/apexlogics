  "mcp_tool_definition": {
    "name": "estimate_teacher_pension",
    "description": "Estimate annual pension, lifetime PV, replacement rate, and vesting-cliff cost from a K-12 defined-benefit pension plan. All plan parameters are user-supplied.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "multiplier": { "type": "number", "description": "Per-year benefit multiplier (%), e.g. 2.0" },
        "vestingYears": { "type": "integer", "description": "Minimum years to retain any pension" },
        "fasType": { "type": "integer", "enum": [1, 3, 5], "description": "FAS averaging window (years)" },
        "currentYears": { "type": "integer", "description": "Current years of service" },
        "plannedRetYears": { "type": "integer", "description": "Total planned years at retirement" },
        "currentSalary": { "type": "number", "description": "Current annual salary ($)" },
        "salaryGrowthPct": { "type": "number", "description": "Annual salary growth % (default 2.5)" },
        "estYearsInRetirement": { "type": "integer", "description": "Projected years in retirement (default 20)" },
        "pensionColaPct": { "type": "number", "description": "Post-retirement COLA % (default 1.5)" },
        "discountRate": { "type": "number", "description": "NPV discount rate % (default 4.0)" }
      },
      "required": ["multiplier", "vestingYears", "fasType", "currentYears", "plannedRetYears", "currentSalary"]
    }
  }
}
