{
  "tool_id": "al-33-equity-compensation-analyzer",
  "al_id": "AL-33",
  "version": "1.0.0",
  "title": "Equity Compensation Analyzer",
  "description": "Deep analysis of RSU and stock option grants. Tab 1: RSU vesting analyzer — models cliff and graded vesting schedules, projects taxable income at each vest event, applies LTCG treatment for shares held beyond 1 year, and flags AMT exposure for ISO grants. Tab 2: multi-offer equity stack — 3-offer NPV comparison combining cash, RSU, ISO/NSO options, and signing bonus with equity vs. cash equivalence calculator. Legal disclaimer prominently displayed.",
  "category": "compensation_offers",
  "journeys": ["compensation_benefits"],
  "personas": ["working_professional", "career_changer"],
  "tags": ["rsu", "iso", "nso", "options", "equity", "vesting", "amt", "ltcg", "total comp", "npv", "cliff vesting"],
  "status": "shipped",
  "shipped_date": "2026-05-19",
  "display_num": "#21",
  "maintenance": "low",
  "data_vintage": "IRS AMT exemption 2024 · IRS LTCG brackets 2024 · IRS Pub 15-T 2024",
  "frozen_baseline": false,
  "legal_disclaimer_required": true,
  "content_filter_risk": "low_medium",
  "input_schema": {
    "type": "object",
    "required": ["grant_type"],
    "properties": {
      "grant_type": {
        "type": "string",
        "enum": ["rsu", "iso", "nso", "mixed"],
        "description": "Type of equity grant"
      },
      "grant_value": { "type": "number", "minimum": 0, "description": "Total grant value in USD (or shares × current price)" },
      "shares": { "type": "integer", "minimum": 0, "description": "Number of shares granted" },
      "current_price": { "type": "number", "minimum": 0, "description": "Current stock price per share" },
      "strike_price": { "type": "number", "minimum": 0, "description": "Option strike/exercise price (ISO/NSO only)" },
      "vesting_schedule": {
        "type": "string",
        "enum": ["cliff_1yr", "graded_4yr_1yr_cliff", "graded_3yr", "graded_4yr_monthly", "custom"],
        "default": "graded_4yr_1yr_cliff",
        "description": "Vesting schedule type"
      },
      "expected_price_growth_pct": { "type": "number", "default": 0, "description": "Expected annual stock price growth %" },
      "federal_rate_pct": { "type": "number", "minimum": 0, "maximum": 50, "description": "Federal marginal income tax rate %" },
      "state": { "type": "string", "description": "State for supplemental withholding rate" },
      "filing_status": { "type": "string", "enum": ["single", "mfj", "mfs", "hoh"], "default": "single" }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "vest_schedule": {
        "type": "array",
        "description": "Per-vest-event tax breakdown",
        "items": {
          "type": "object",
          "properties": {
            "year": { "type": "integer" },
            "shares_vesting": { "type": "integer" },
            "value_at_vest": { "type": "number" },
            "ordinary_income": { "type": "number" },
            "federal_tax": { "type": "number" },
            "state_tax": { "type": "number" },
            "net_value": { "type": "number" }
          }
        }
      },
      "total_gross_value": { "type": "number", "description": "Total grant value at current price" },
      "total_tax": { "type": "number", "description": "Total estimated tax across all vest events" },
      "total_net_value": { "type": "number", "description": "After-tax equity value" },
      "amt_flag": { "type": "boolean", "description": "Whether ISO exercise triggers AMT exposure" },
      "amt_exposure": { "type": "number", "description": "Estimated AMT exposure amount if applicable" },
      "ltcg_eligible": { "type": "boolean", "description": "Whether shares qualify for LTCG treatment" },
      "npv_3offers": { "type": "array", "description": "NPV comparison of up to 3 equity stacks (Tab 2)" }
    }
  },
  "mcp_tool_definition": {
    "name": "analyze_equity_compensation",
    "description": "Analyze RSU and ISO/NSO stock option grants. Models cliff and graded vesting schedules, per-vest-event tax (federal + state), LTCG eligibility, and AMT exposure for ISOs. Tab 2: 3-offer equity NPV comparison. Uses IRS 2024 AMT exemption, LTCG brackets, and supplemental rates. NOT tax or financial advice.",
    "inputSchema": {
      "type": "object",
      "required": ["grant_type"],
      "properties": {
        "grant_type": { "type": "string", "enum": ["rsu", "iso", "nso", "mixed"] },
        "grant_value": { "type": "number" },
        "shares": { "type": "integer" },
        "current_price": { "type": "number" },
        "vesting_schedule": { "type": "string", "default": "graded_4yr_1yr_cliff" },
        "federal_rate_pct": { "type": "number" },
        "state": { "type": "string" }
      }
    }
  },
  "execution": {
    "type": "browser-javascript",
    "entry": "index.html",
    "function_name": "runGrantAnalysis",
    "secondary_function_names": ["runCompStack"],
    "timeout_ms": 5000
  },
  "ap2_export": true,
  "ap2_mandate_types": ["equity_compensation_record"],
  "ap2_inbound_mandate_types": ["offer_negotiation_record"],
  "downstream_handoff_candidates": ["AL-23", "AL-25"],
  "regulatory_citations": [
    "IRC §422 — Incentive Stock Options",
    "IRC §83 — RSU taxation at vest",
    "IRC §55 — Alternative Minimum Tax",
    "IRS Rev. Proc. 2023-34 — 2024 AMT exemption amounts",
    "IRS Publication 15-T (2024) — federal income tax withholding methods"
  ],
  "sister_suite": "https://ainumbers.co",
  "consulting_site": "https://apexadvisory.site",
  "license": "CC-BY-4.0"
}
