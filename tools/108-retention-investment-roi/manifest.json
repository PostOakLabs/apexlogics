        "avg_salary": {"type": "number"},
        "headcount": {"type": "integer"},
        "current_attrition_pct": {"type": "number"},
        "cost_per_departure": {"type": "number"},
        "intervention_cost_per_employee": {"type": "number"},
        "expected_attrition_reduction_pp": {"type": "number", "default": 5},
        "horizon_years": {"type": "integer", "default": 3}
      }
    }
  }
