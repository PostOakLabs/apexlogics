{
  "tool_id": "military-civilian-salary-bridge",
  "al_id": "AL-40",
  "version": "1.0.0",
  "title": "Military-to-Civilian Salary Bridge",
  "description": "Calculates total military compensation (base pay + BAH + BAS + TRICARE + TSP match + leave value) and converts it to a civilian salary floor using a 22% tax gross-up for tax-free allowances. Embeds full 2025 DoD base pay tables (E-1 through O-10), BAH rates for 20 metro areas, and sector adjustments for private/federal/contractor/nonprofit. Estimates GI Bill value and benefits gaps.",
  "category": "career_transition_mobility",
  "journeys": ["career_transition", "compensation_benefits"],
  "personas": ["working_professional", "career_changer"],
  "tags": ["military", "veteran", "salary", "bah", "bas", "gi-bill", "transition"],
  "status": "shipped",
  "shipped_date": "2026-05-28",
  "maintenance": "low",
  "data_vintage": "DoD Military Pay Tables 2025, BAH rates 2025, GI Bill rates 2024-25",
  "frozen_baseline": false,
  "input_schema": {
    "type": "object",
    "properties": {
      "grade": { "type": "string", "description": "Pay grade e.g. E-5, O-3, W-2" },
      "years": { "type": "integer", "minimum": 1, "maximum": 40 },
      "dependents": { "type": "string", "enum": ["single", "with_dep"] },
      "location": { "type": "string", "description": "Duty station metro area" },
      "separation": { "type": "string", "enum": ["ets", "medical", "retirement"] },
      "sector": { "type": "string", "enum": ["Private sector", "Federal civilian (GS)", "State/local government", "Nonprofit", "Defense contractor"] },
      "use_gi_bill": { "type": "boolean" }
    },
    "required": ["grade", "years", "dependents", "location", "separation", "sector"]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "military_total_comp": { "type": "number" },
      "civilian_floor_base": { "type": "number" },
      "civilian_floor_sector_adjusted": { "type": "number" },
      "gi_bill_annual_value": { "type": "number" },
      "pension_annual": { "type": "number" },
      "component_breakdown": {
        "type": "object",
        "properties": {
          "base": { "type": "number" },
          "bah": { "type": "number" },
          "bas": { "type": "number" },
          "tricare": { "type": "number" },
          "tsp": { "type": "number" },
          "leave": { "type": "number" }
        }
      }
    }
  },
  "mcp_tool_definition": {
    "name": "bridge_military_civilian_salary",
    "description": "Given military pay grade, years of service, dependents status, duty station, and target civilian sector, returns total military comp, civilian salary floor (tax-grossed), sector-adjusted floor, and optional GI Bill value. Uses embedded 2025 DoD pay tables. Deterministic.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "grade": { "type": "string" },
        "years": { "type": "integer" },
        "dependents": { "type": "string" },
        "location": { "type": "string" },
        "sector": { "type": "string" }
      },
      "required": ["grade", "years", "dependents", "location", "sector"]
    }
  },
  "execution": {
    "type": "browser-javascript",
    "entry": "index.html",
    "function_name": "calculate",
    "timeout_ms": 3000
  },
  "ap2_export": true,
  "ap2_mandate_types": ["military_civilian_record"],
  "downstream_handoff_candidates": ["AL-01"],
  "sister_suite": "https://ainumbers.co",
  "consulting_site": "https://apexadvisory.site",
  "license": "CC-BY-4.0",
  "regulatory_citations": [
    "DoD Military Pay Tables — January 2025",
    "DoD BAH Rate Lookup 2025 — Defense Travel Management Office",
    "38 U.S.C. Chapter 33 — Post-9/11 GI Bill",
    "NDAA 2016 — Blended Retirement System (BRS)"
  ]
}
