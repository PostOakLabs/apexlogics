    "name": "hdhp_vs_ppo_break_even",
    "description": "Calculate the medical-spend break-even point where HDHP+HSA beats PPO in annual total cost, including HSA tax shield. Returns break-even spend, net savings at expected spend, and plan recommendation.",
    "inputSchema": {
      "type": "object",
      "required": ["hdhp_premium_monthly", "ppo_premium_monthly", "hdhp_deductible", "ppo_deductible"],
      "properties": {
        "hdhp_premium_monthly": {"type": "number"},
        "ppo_premium_monthly": {"type": "number"},
        "hdhp_deductible": {"type": "number"},
        "ppo_deductible": {"type": "number"},
        "hdhp_oop_max": {"type": "number", "default": 7000},
        "ppo_oop_max": {"type": "number", "default": 5000},
        "coinsurance_pct": {"type": "number", "default": 20},
        "employer_hsa_contribution": {"type": "number", "default": 0},
        "expected_annual_spend": {"type": "number", "default": 3000},
        "marginal_tax_rate_pct": {"type": "number", "default": 22},
        "coverage": {"type": "string", "enum": ["individual","family"], "default": "individual"}
      }
    }
  }
