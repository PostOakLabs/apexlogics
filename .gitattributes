# Enforce LF line endings for all text files.
# Prevents CRLF/LF phantom diffs on Windows checkouts.

* text=auto eol=lf

*.html   text eol=lf
*.json   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.md     text eol=lf
*.txt    text eol=lf
*.css    text eol=lf
*.js     text eol=lf
*.py     text eol=lf
*.svg    text eol=lf
*.xml    text eol=lf

# Binary assets — do not touch line endings
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.woff   binary
*.woff2  binary
